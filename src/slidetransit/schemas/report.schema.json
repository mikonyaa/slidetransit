{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikonyaa.github.io/slidetransit/schemas/report-1.0.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "const": "SlideTransit"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "comparisonId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "presentation",
        "reference",
        "candidate"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementationHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "hash",
        "implementationHash",
        "parameters"
      ],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "properties": {
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 200
        },
        "pixel_delta": {
          "type": "integer",
          "minimum": 1,
          "maximum": 254
        },
        "displacement_pt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 72
        },
        "size_pt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 72
        },
        "fail_on": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "dpi",
        "pixel_delta",
        "displacement_pt",
        "size_pt",
        "fail_on"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "declared-same-source",
            "documented-test-variant",
            "unknown"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "slideRange": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "pageOrder": {
              "const": "source-order"
            },
            "kind": {
              "const": "slides"
            },
            "includeHidden": {
              "type": "boolean"
            }
          },
          "required": [
            "slideRange",
            "pageOrder",
            "kind",
            "includeHidden"
          ],
          "additionalProperties": false
        },
        "exports": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "object"
            },
            "candidate": {
              "type": "object"
            }
          },
          "required": [
            "reference",
            "candidate"
          ],
          "additionalProperties": false
        },
        "statement": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "scope",
        "exports",
        "statement",
        "limitations"
      ],
      "additionalProperties": false
    },
    "coordinates": {
      "type": "string"
    },
    "analysisStatus": {
      "enum": [
        "complete",
        "incomplete",
        "error"
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "correspondence": {
            "enum": [
              "declared-order",
              "unresolved"
            ]
          },
          "reference": {
            "type": "object",
            "properties": {
              "raster": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "text": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "geometry": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "characters": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              }
            },
            "required": [
              "raster",
              "text",
              "geometry"
            ],
            "additionalProperties": false
          },
          "candidate": {
            "type": "object",
            "properties": {
              "raster": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "text": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "geometry": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              },
              "characters": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable",
                  "absent"
                ]
              }
            },
            "required": [
              "raster",
              "text",
              "geometry"
            ],
            "additionalProperties": false
          },
          "rasterComparison": {
            "enum": [
              "complete",
              "unavailable-different-page-size",
              "unavailable-different-raster-grid",
              "unavailable-unresolved-correspondence"
            ]
          }
        },
        "required": [
          "page",
          "correspondence",
          "reference",
          "candidate"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSlide": {
            "type": "integer",
            "minimum": 1
          },
          "correspondence": {
            "enum": [
              "declared-order",
              "unresolved"
            ]
          },
          "reference": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotation": {
                    "enum": [
                      0,
                      90,
                      180,
                      270
                    ]
                  },
                  "mediaBox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "cropBox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^assets/[^/\\\\:\\u0000]+\\.png$"
                  },
                  "rasterSize": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "textBlocks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "normalized": {
                          "type": "string"
                        },
                        "bbox": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "sizePt": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "characters": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "bbox": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                              },
                              "size": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "horizontal": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "text",
                              "bbox",
                              "size",
                              "horizontal"
                            ],
                            "additionalProperties": false
                          },
                          "maxItems": 100000
                        }
                      },
                      "required": [
                        "text",
                        "normalized",
                        "bbox",
                        "lines",
                        "sizePt",
                        "characters"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 100000
                  }
                },
                "required": [
                  "width",
                  "height",
                  "rotation",
                  "mediaBox",
                  "cropBox",
                  "image",
                  "textBlocks"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotation": {
                    "enum": [
                      0,
                      90,
                      180,
                      270
                    ]
                  },
                  "mediaBox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "cropBox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^assets/[^/\\\\:\\u0000]+\\.png$"
                  },
                  "rasterSize": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "textBlocks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "normalized": {
                          "type": "string"
                        },
                        "bbox": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "sizePt": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "characters": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "bbox": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                              },
                              "size": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "horizontal": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "text",
                              "bbox",
                              "size",
                              "horizontal"
                            ],
                            "additionalProperties": false
                          },
                          "maxItems": 100000
                        }
                      },
                      "required": [
                        "text",
                        "normalized",
                        "bbox",
                        "lines",
                        "sizePt",
                        "characters"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 100000
                  }
                },
                "required": [
                  "width",
                  "height",
                  "rotation",
                  "mediaBox",
                  "cropBox",
                  "image",
                  "textBlocks"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "mask": {
            "type": "string",
            "pattern": "^assets/[^/\\\\:\\u0000]+\\.png$"
          }
        },
        "required": [
          "page",
          "sourceSlide",
          "correspondence",
          "reference",
          "candidate"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "regionHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ruleId": {
            "type": "string"
          },
          "ruleVersion": {
            "type": "string"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "referenceBBox": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "candidateBBox": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "cropReferences": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string"
              },
              "candidate": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "attribution": {
            "type": "object"
          },
          "reviewState": {
            "enum": [
              "open",
              "accepted",
              "region-accepted"
            ]
          }
        },
        "required": [
          "id",
          "regionHash",
          "ruleId",
          "ruleVersion",
          "page",
          "severity",
          "title",
          "evidence",
          "referenceBBox",
          "candidateBBox",
          "cropReferences",
          "attribution",
          "reviewState"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "accept-difference"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "regionHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "findingId": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "reason",
                  "timestamp",
                  "regionHash",
                  "findingId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "ignore-region"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "regionHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "region": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "type",
                  "reason",
                  "timestamp",
                  "regionHash",
                  "page",
                  "region"
                ],
                "additionalProperties": false
              }
            ]
          },
          "state": {
            "enum": [
              "applied",
              "stale"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "affectedFindings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5000
          }
        },
        "required": [
          "decision",
          "state",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "zip_entries": {
          "type": "integer",
          "minimum": 1
        },
        "xml_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "expanded_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "page_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "characters_per_page": {
          "type": "integer",
          "minimum": 1
        },
        "characters_per_document": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "html_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "report_json_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "worker_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "file_bytes",
        "zip_entries",
        "xml_bytes",
        "expanded_bytes",
        "pages",
        "page_pixels",
        "characters_per_page",
        "characters_per_document",
        "findings",
        "output_bytes",
        "html_bytes",
        "report_json_bytes",
        "worker_seconds"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "unhandledAtThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "regionAccepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "staleDecisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "exitCode": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "result": {
          "enum": [
            "differences",
            "incomplete",
            "error",
            "checked-scope-clear"
          ]
        }
      },
      "required": [
        "findings",
        "unhandledAtThreshold",
        "accepted",
        "regionAccepted",
        "staleDecisions",
        "exitCode",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "comparisonId",
    "inputs",
    "rules",
    "renderer",
    "config",
    "provenance",
    "coordinates",
    "analysisStatus",
    "coverage",
    "pages",
    "findings",
    "decisions",
    "limits",
    "limitations",
    "summary"
  ],
  "additionalProperties": false
}
